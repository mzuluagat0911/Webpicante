{
  "rewrites": [
    { "source": "/pulse/blog", "destination": "/blog/pulse.html" },
    { "source": "/en/pulse/blog", "destination": "/en/blog/pulse.html" },
    { "source": "/pulse/privacidad", "destination": "/pulse-privacidad.html" },
    { "source": "/pulse/terminos", "destination": "/pulse-terminos.html" },
    { "source": "/pulse", "destination": "/pulse.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/en/blog", "destination": "/en/blog/index.html" },
    { "source": "/en/blog/:slug", "destination": "/en/blog/:slug.html" }
  ],
  "redirects": [
    { "source": "/pulse/pulse.html", "destination": "/pulse", "permanent": true },
    { "source": "/pulse/pulse-privacidad.html", "destination": "/pulse/privacidad", "permanent": true },
    { "source": "/pulse/pulse-terminos.html", "destination": "/pulse/terminos", "permanent": true },
    { "source": "/pulse-privacidad.html", "destination": "/pulse/privacidad", "permanent": true },
    { "source": "/pulse-terminos.html", "destination": "/pulse/terminos", "permanent": true },
    { "source": "/pulse.html", "destination": "/pulse", "permanent": true },
    { "source": "/blog/pulse/", "destination": "/pulse/blog", "permanent": true },
    { "source": "/en/blog/pulse/", "destination": "/en/pulse/blog", "permanent": true }
  ]
}
